{
  "info": {
    "name": "KH3T Checkout -> Payment",
    "_postman_id": "kh3t-checkout-payment",
    "description": "Collection to test add-to-cart -> order -> invoice -> SePay callback",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Cart by Account",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/carts/account/{{accountId}}",
          "host": ["{{baseUrl}}"],
          "path": ["carts","account","{{accountId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.result && json.result.id) { pm.environment.set('cartId', json.result.id); }",
              "console.log('cartId ->', pm.environment.get('cartId'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Selected Items",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/cart-details/cart/{{cartId}}/selected",
          "host": ["{{baseUrl}}"],
          "path": ["cart-details","cart","{{cartId}}","selected"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["const arr = pm.response.json(); if (Array.isArray(arr) && arr.length>0) pm.environment.set('cartDetailId', arr[0].id);"] }
        }
      ]
    },
    {
      "name": "Add To Cart",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": {{productId}},\n  \"cartId\": {{cartId}},\n  \"sizeDetailId\": {{sizeDetailId}},\n  \"quantity\": 1\n}"
        },
        "url": { "raw": "{{baseUrl}}/cart-details/add-to-cart", "host": ["{{baseUrl}}"], "path": ["cart-details","add-to-cart"] }
      },
      "event": [
        { "listen": "test", "script": { "exec": ["const json = pm.response.json(); if (json && json.id) pm.environment.set('cartDetailId', json.id);"] } }
      ]
    },
    {
      "name": "Select CartDetail",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"selected\": true\n}" },
        "url": { "raw": "{{baseUrl}}/cart-details/{{cartDetailId}}/select", "host": ["{{baseUrl}}"], "path": ["cart-details","{{cartDetailId}}","select"] }
      }
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"note\": \"Test checkout\",\n  \"customerTradingId\": 1,\n  \"account_id\": {{accountId}},\n  \"paymentMethod\": \"BANK_TRANSFER\"\n}" },
        "url": { "raw": "{{baseUrl}}/orders/create", "host": ["{{baseUrl}}"], "path": ["orders","create"] }
      },
      "event": [ { "listen": "test", "script": { "exec": ["const json = pm.response.json(); if (json && json.id) pm.environment.set('orderId', json.id);"] } } ]
    },
    {
      "name": "Create Invoice",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{orderId}},\n  \"paymentMethod\": \"BANK_TRANSFER\",\n  \"paymentStatus\": \"UNPAID\"\n}" },
        "url": { "raw": "{{baseUrl}}/invoices", "host": ["{{baseUrl}}"], "path": ["invoices"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.id) pm.environment.set('invoiceId', json.id);",
              "if (json && json.invoiceCode) pm.environment.set('invoiceCode', json.invoiceCode);",
              "if (json && json.totalAmount) pm.environment.set('invoiceTotal', json.totalAmount);",
              "console.log('invoiceId', pm.environment.get('invoiceId'))"
            ]
          }
        }
      ]
    },
    {
      "name": "SePay Callback (simulate)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Apikey {{apiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gateway\": \"SEPAY\",\n  \"transactionDate\": \"2026-05-29T12:00:00\",\n  \"accountNumber\": \"0123456789\",\n  \"code\": \"{{invoiceCode}}\",\n  \"content\": \"\",\n  \"transferType\": \"in\",\n  \"transferAmount\": {{invoiceTotal}}\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/payment/sepay-callback", "host": ["{{baseUrl}}"], "path": ["api","v1","payment","sepay-callback"] }
      }
    },
    {
      "name": "Get Invoice",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/invoices/{{invoiceId}}", "host": ["{{baseUrl}}"], "path": ["invoices","{{invoiceId}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["const json = pm.response.json(); pm.test('paymentStatus is PAID', () => { pm.expect(json.paymentStatus).to.eql('PAID'); });"] }
        }
      ]
    }
  ]
}
{
  "info": {
    "name": "KH3T Shop - Checkout to Payment",
    "_postman_id": "0f6c3f12-8a3c-4f9f-a3c0-2cb4ccf4b111",
    "description": "Flow test from cart -> order -> invoice -> SePay callback -> verify PAID status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Get cart by account",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/carts/account/{{accountId}}",
          "host": ["{{baseUrl}}"],
          "path": ["carts", "account", "{{accountId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json).to.have.property('result');",
              "pm.environment.set('cartId', json.result.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Get selected cart details",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/cart-details/cart/{{cartId}}/selected",
          "host": ["{{baseUrl}}"],
          "path": ["cart-details", "cart", "{{cartId}}", "selected"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.environment.set('selectedCount', Array.isArray(json) ? json.length : 0);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Create order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"note\": \"Kịch bản test thanh toán đơn hàng\",\n  \"customerTradingId\": {{customerTradingId}},\n  \"account_id\": {{accountId}},\n  \"paymentMethod\": \"BANK_TRANSFER\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders/create",
          "host": ["{{baseUrl}}"],
          "path": ["orders", "create"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 or 201', function () {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "var json = pm.response.json();",
              "pm.environment.set('orderId', json.id);",
              "pm.environment.set('orderCode', json.orderCode);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Create invoice",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": {{orderId}},\n  \"paymentMethod\": \"BANK_TRANSFER\",\n  \"paymentStatus\": \"UNPAID\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/invoices",
          "host": ["{{baseUrl}}"],
          "path": ["invoices"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "pm.environment.set('invoiceId', json.id);",
              "pm.environment.set('invoiceCode', json.invoiceCode);",
              "pm.environment.set('invoiceTotalAmount', json.totalAmount);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Send SePay callback",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Apikey {{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gateway\": \"SEPAY\",\n  \"transactionDate\": \"{{now}}\",\n  \"accountNumber\": \"970422\",\n  \"subAccount\": \"\",\n  \"code\": \"{{invoiceCode}}\",\n  \"content\": \"Thanh toan don hang {{invoiceCode}}\",\n  \"transferType\": \"in\",\n  \"description\": \"Payment for order test\",\n  \"transferAmount\": {{invoiceTotalAmount}},\n  \"referenceCode\": \"REF-{{orderCode}}\",\n  \"accumulated\": {{invoiceTotalAmount}},\n  \"id\": 10001\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/payment/sepay-callback",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "payment", "sepay-callback"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json).to.have.property('isSuccess');",
              "pm.expect(json.isSuccess).to.eql(true);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Verify invoice paid",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/invoices/{{invoiceId}}",
          "host": ["{{baseUrl}}"],
          "path": ["invoices", "{{invoiceId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.paymentStatus).to.eql('PAID');"
            ]
          }
        }
      ]
    }
  ],
  "event": [],
  "variable": [
    {"key": "cartId", "value": "1"},
    {"key": "customerTradingId", "value": "1"},
    {"key": "orderId", "value": ""},
    {"key": "orderCode", "value": ""},
    {"key": "invoiceId", "value": ""},
    {"key": "invoiceCode", "value": ""},
    {"key": "invoiceTotalAmount", "value": "0"},
    {"key": "selectedCount", "value": "0"},
    {"key": "apiKey", "value": "KH3T_SHOP_KEY"},
    {"key": "now", "value": "2026-05-29 10:00:00"}
  ]
}
